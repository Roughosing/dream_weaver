# Copy this file to .env and fill in your API keys

# OpenAI API Key (for ChatGPT and DALL-E 3)
OPENAI_API_KEY=your_openai_api_key_here

# Image Generator Selection
# Options: placeholder, dalle3, midjourney, stability, gemini
IMAGE_GENERATOR=gemini

# Stability AI API Key (if using Stability AI)
# STABILITY_API_KEY=your_stability_api_key_here

# Midjourney API Key (if using Midjourney via third-party)
# MIDJOURNEY_API_KEY=your_midjourney_api_key_here

# Gemini API Key (for text enhancement and image generation)
